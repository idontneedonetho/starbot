# Discord bot token
DISCORD_TOKEN=

# Discord guild/server id
GUILD_ID=

# Channel ids used by the bot
IDENTIFICATION_CHANNEL_ID=
FORUM_CHANNEL_ID=
ROUTES_CHANNEL_ID=

# Comma-separated role ids that the bot should ignore
# Example: IGNORED_ROLES=roleId1,roleId2
IGNORED_ROLES=

# Wiki clone settings (used to build the wiki search index)
# Defaults: WIKI_CLONE_URL=https://github.com/StarPilot-Docs/docs.git
#           WIKI_CLONE_PATH=data/docs
WIKI_CLONE_URL=
WIKI_CLONE_PATH=
